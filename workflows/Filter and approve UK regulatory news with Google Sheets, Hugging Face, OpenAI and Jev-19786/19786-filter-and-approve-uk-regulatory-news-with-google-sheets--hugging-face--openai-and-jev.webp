{"id":"iUKwQtyXmiQ93311","meta":{"instanceId":"91ff29cf289b94d2caa8a7a4821e53d150affc29af69fb5d8a62fce13e322667","builderVariant":"mcp","aiBuilderAssisted":true},"name":"Filter, Deduplicate and Approve Articles with Embeddings and Jev","tags":[{"id":"WiPfwUZYcO7Er2qC","name":"Template","createdAt":"2026-02-10T16:54:20.430Z","updatedAt":"2026-02-10T16:54:20.430Z"}],"nodes":[{"id":"e6c445b6-8966-4a31-bd8e-81dd5989dd7c","name":"Run the pipeline","type":"n8n-nodes-base.manualTrigger","position":[-208,64],"parameters":{},"typeVersion":1},{"id":"3e1bfc9c-6092-4286-93e0-c18673b382c7","name":"Test hook (temporary)","type":"n8n-nodes-base.webhook","position":[-208,256],"webhookId":"5d5cb8ed-aa6e-47f3-be90-94ce89f004d6","parameters":{"path":"5d5cb8ed-aa6e-47f3-be90-94ce89f004d6","options":{}},"typeVersion":2},{"id":"2ac25885-cf6c-4c7d-baed-e99df30ccaae","name":"Configure context","type":"n8n-nodes-base.set","position":[16,64],"parameters":{"options":{},"assignments":{"assignments":[{"id":"c01","name":"sheetDocumentId","type":"string","value":"1Cmhh8FO9cljzfjni396o442rmLR31qJ1EtGcVFpAV6w"},{"id":"c16","name":"sourceTab","type":"string","value":"Source Articles"},{"id":"c02","name":"articlesTab","type":"string","value":"Articles"},{"id":"c03","name":"approvedTab","type":"string","value":"Approved Package"},{"id":"c04","name":"rulesKeywords","type":"object","value":"{\"consultation paper\": 3, \"policy statement\": 3, \"dear ceo\": 3, \"consumer duty\": 3, \"operational resilience\": 3, \"app fraud\": 3, \"market bulletin\": 2, \"safeguarding\": 2, \"payment services\": 2, \"stablecoin\": 2, \"e-money\": 2, \"aml\": 2, \"financial crime\": 2, \"enforcement\": 2, \"fca\": 2, \"pra\": 2, \"regulation\": 2, \"regulatory\": 2, \"cyber\": 2, \"resilience\": 2, \"fraud\": 2, \"bnpl\": 2, \"bans\": 2, \"banned\": 2, \"fined\": 2, \"fines\": 2, \"tribunal\": 2, \"annex 1\": 2, \"transaction reporting\": 2, \"t+1\": 2, \"financial promotion\": 2, \"redress\": 2, \"kyc\": 2, \"ban\": 1, \"fine\": 1, \"regulator\": 1, \"authorisation\": 1, \"deadline\": 1, \"capital\": 1, \"rtgs\": 1, \"tokenised\": 1, \"crypto\": 1, \"whistleblowing\": 1, \"warning\": 1, \"administration\": 1, \"review\": 1, \"settlement\": 1, \"promotions\": 1, \"illegal\": 1, \"scrutiny\": 1, \"handbook\": 1, \"listing\": 1, \"listings\": 1, \"transparency\": 1, \"compliance\": 1}"},{"id":"c05","name":"sourceWeights","type":"object","value":"{\"FCA\": 3, \"Bank of England\": 2, \"Payment Systems Regulator\": 2, \"Compliance Week\": 1, \"Money Marketing\": 1, \"Finextra\": 1, \"FStech\": 1, \"The Fintech Times\": 1}"},{"id":"c06","name":"rulesRejectThreshold","type":"number","value":4},{"id":"c07","name":"rulesHardWinThreshold","type":"number","value":10},{"id":"c08","name":"clusterSimilarityThreshold","type":"number","value":0.7},{"id":"c15","name":"clearBeforeRun","type":"boolean","value":true},{"id":"c09","name":"embeddingProvider","type":"string","value":"huggingface"},{"id":"c10","name":"hfEmbeddingModel","type":"string","value":"sentence-transformers/all-MiniLM-L6-v2"},{"id":"c11","name":"openaiEmbeddingModel","type":"string","value":"text-embedding-3-small"},{"id":"c12","name":"judgeModel","type":"string","value":"gpt-5-mini"},{"id":"c14","name":"useLiveFetch","type":"boolean","value":true},{"id":"c13","name":"nicheContext","type":"string","value":"UK financial services regulatory change that a fintech or payments firm must act on: FCA and PRA policy, consultation papers and Dear CEO letters, enforcement action and fines, safeguarding and operational resilience, consumer duty, APP fraud reimbursement, e-money and payment services, stablecoin and crypto regulation, and Bank of England payment-system changes. Reject consumer-facing money tips, product marketing, appointments, and general fintech commentary with no regulatory consequence."}]}},"typeVersion":3.4},{"id":"680e7032-45b1-46a8-b1b8-377542e7e08c","name":"Clear previous packages","type":"n8n-nodes-base.googleSheets","position":[464,0],"parameters":{"operation":"clear","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.approvedTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"},"keepFirstRow":true},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"988a08fc-1fd9-4698-816e-d7b61828c28f","name":"Read source articles","type":"n8n-nodes-base.googleSheets","position":[1136,-32],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.sourceTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"}},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"31e01e53-0e33-4422-bf61-281bbc7f8fee","name":"Score with rules (Step 1)","type":"n8n-nodes-base.code","position":[2256,160],"parameters":{"jsCode":"// Step 1 of 3: deterministic scoring. Free, instant, and it never changes its mind.\n// Code instead of a native IF-chain: the keyword and source weight maps live in\n// 'Configure context', and native nodes cannot iterate a configurable map.\nconst config = $('Configure context').first().json;\nconst keywordWeights = config.rulesKeywords;\nconst sourceWeights = config.sourceWeights;\n\nconst scoredItems = [];\nfor (const item of $input.all()) {\n  const article = item.json;\n  const titleText = String(article.title || '').toLowerCase();\n  const bodyText = (String(article.summary || '') + ' ' + String(article.content_excerpt || '')).toLowerCase();\n\n  // A keyword in the headline is worth double a keyword buried in the body.\n  // Word-boundary matching: 'ai' must not match inside 'bargain'.\n  let keywordScore = 0;\n  for (const [term, weight] of Object.entries(keywordWeights)) {\n    const escapedTerm = term.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    const termPattern = new RegExp(`\\\\b${escapedTerm}\\\\b`, 'i');\n    if (termPattern.test(titleText)) keywordScore += weight * 2;\n    else if (termPattern.test(bodyText)) keywordScore += weight;\n  }\n  const sourceScore = sourceWeights[article.source] || 0;\n  const rulesScore = keywordScore + sourceScore;\n\n  let rulesBand = 'pass';\n  if (rulesScore < config.rulesRejectThreshold) rulesBand = 'reject';\n  else if (rulesScore >= config.rulesHardWinThreshold) rulesBand = 'hardWin';\n\n  scoredItems.push({ json: { ...article, rulesScore, rulesBand, embedText: `${article.title}. ${article.summary}` } });\n}\nreturn scoredItems;"},"typeVersion":2},{"id":"bccbbedf-8541-4946-b1cc-5ad3b1581ca3","name":"Drop rejected noise","type":"n8n-nodes-base.filter","position":[2480,160],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"f1","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.rulesBand }}","rightValue":"reject"}]}},"typeVersion":2.2},{"id":"2191b35f-7d49-4cfd-95b4-1972995da43e","name":"Collect batch for embedding","type":"n8n-nodes-base.aggregate","position":[2704,160],"parameters":{"options":{},"aggregate":"aggregateAllItemData"},"typeVersion":1},{"id":"867ac716-357a-4502-b653-448f5cb422cf","name":"Choose embedding provider","type":"n8n-nodes-base.switch","position":[2928,160],"parameters":{"rules":{"values":[{"outputKey":"Hugging Face","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"s1","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $('Configure context').first().json.embeddingProvider }}","rightValue":"huggingface"}]},"renameOutput":true},{"outputKey":"OpenAI","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"s2","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $('Configure context').first().json.embeddingProvider }}","rightValue":"openai"}]},"renameOutput":true}]},"options":{}},"typeVersion":3.2},{"id":"7ec5c472-ea20-4494-8661-56ae49871549","name":"Embed with Hugging Face","type":"n8n-nodes-base.httpRequest","position":[3152,-32],"parameters":{"url":"={{ 'https://router.huggingface.co/hf-inference/models/' + $('Configure context').first().json.hfEmbeddingModel + '/pipeline/feature-extraction' }}","method":"POST","options":{"response":{"response":{"fullResponse":true}}},"jsonBody":"={{ JSON.stringify({ inputs: $json.data.map(article => article.embedText) }) }}","sendBody":true,"specifyBody":"json","authentication":"predefinedCredentialType","nodeCredentialType":"huggingFaceApi"},"credentials":{"huggingFaceApi":{"id":"x4yVn0QWp85Yc1od","name":"Stephen Hugging Face"}},"typeVersion":4.2},{"id":"8cdd2fc1-7e50-4bbf-9537-d6cc12e4736d","name":"Embed with OpenAI","type":"n8n-nodes-base.httpRequest","position":[3152,160],"parameters":{"url":"https://api.openai.com/v1/embeddings","method":"POST","options":{"response":{"response":{"fullResponse":true}}},"jsonBody":"={{ JSON.stringify({ model: $('Configure context').first().json.openaiEmbeddingModel, input: $json.data.map(article => article.embedText) }) }}","sendBody":true,"specifyBody":"json","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi"},"credentials":{"openAiApi":{"id":"i9Ww0IA5iHyFrvkx","name":"Stephen OpenAi account"}},"typeVersion":4.2},{"id":"ba33c745-a012-4f11-8825-c9ea647e7c95","name":"Normalize HF vectors","type":"n8n-nodes-base.set","position":[3376,-32],"parameters":{"options":{},"assignments":{"assignments":[{"id":"n1","name":"vectors","type":"array","value":"={{ $json.body }}"}]}},"typeVersion":3.4},{"id":"1af49f6a-7215-47c6-9274-3ff34a538822","name":"Normalize OpenAI vectors","type":"n8n-nodes-base.set","position":[3376,160],"parameters":{"options":{},"assignments":{"assignments":[{"id":"n2","name":"vectors","type":"array","value":"={{ $json.body.data.map(entry => entry.embedding) }}"}]}},"typeVersion":3.4},{"id":"f8fd8c38-d905-45f4-ba6a-f0fd764c5f76","name":"Cluster stories (Step 2)","type":"n8n-nodes-base.code","position":[3600,160],"parameters":{"jsCode":"// Step 2 of 3: group near-duplicate coverage of the same story.\n// Code because similarity clustering needs a pairwise cosine matrix,\n// which no native node expresses. Greedy single-link over 50 articles is instant.\n// One item per STORY leaves this node, so the canvas count itself shows the dedup.\nconst config = $('Configure context').first().json;\nconst threshold = Number(config.clusterSimilarityThreshold);\nconst articles = $('Drop rejected noise').all().map(item => item.json);\nconst vectors = $input.first().json.vectors;\nif (!Array.isArray(vectors) || vectors.length !== articles.length) {\n  throw new Error(`Vector count (${vectors && vectors.length}) does not match article count (${articles.length})`);\n}\n\nfunction cosineSimilarity(vectorA, vectorB) {\n  let dotProduct = 0;\n  let magnitudeA = 0;\n  let magnitudeB = 0;\n  for (let dim = 0; dim < vectorA.length; dim++) {\n    dotProduct += vectorA[dim] * vectorB[dim];\n    magnitudeA += vectorA[dim] * vectorA[dim];\n    magnitudeB += vectorB[dim] * vectorB[dim];\n  }\n  return dotProduct / (Math.sqrt(magnitudeA) * Math.sqrt(magnitudeB));\n}\n\nconst clusters = [];\nfor (let articleIndex = 0; articleIndex < articles.length; articleIndex++) {\n  let joinedExisting = false;\n  for (const cluster of clusters) {\n    if (cluster.some(memberIndex => cosineSimilarity(vectors[articleIndex], vectors[memberIndex]) >= threshold)) {\n      cluster.push(articleIndex);\n      joinedExisting = true;\n      break;\n    }\n  }\n  if (!joinedExisting) clusters.push([articleIndex]);\n}\n\n// The primary is picked deterministically: highest rules score, longer excerpt on ties.\n// Every other member rides along on the primary as corroborating coverage.\nconst storyItems = [];\nclusters.forEach((memberIndexes, clusterNumber) => {\n  const primaryIndex = memberIndexes.reduce((bestIndex, candidateIndex) => {\n    const bestArticle = articles[bestIndex];\n    const candidateArticle = articles[candidateIndex];\n    if (candidateArticle.rulesScore !== bestArticle.rulesScore) {\n      return candidateArticle.rulesScore > bestArticle.rulesScore ? candidateIndex : bestIndex;\n    }\n    return String(candidateArticle.content_excerpt || '').length > String(bestArticle.content_excerpt || '').length\n      ? candidateIndex : bestIndex;\n  });\n  const corroborating = memberIndexes\n    .filter(memberIndex => memberIndex !== primaryIndex)\n    .map(memberIndex => ({\n      title: articles[memberIndex].title,\n      source: articles[memberIndex].source,\n      url: articles[memberIndex].url,\n    }));\n  storyItems.push({ json: {\n    ...articles[primaryIndex],\n    clusterId: clusterNumber + 1,\n    clusterSize: memberIndexes.length,\n    isPrimary: true,\n    corroborating,\n  }});\n});\nreturn storyItems;"},"typeVersion":2},{"id":"a14f30c4-a7a5-4e98-aff6-a790d8d17269","name":"Needs LLM judgment?","type":"n8n-nodes-base.if","position":[3824,160],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"i1","operator":{"type":"boolean","operation":"equals"},"leftValue":"={{ $json.isPrimary }}","rightValue":true},{"id":"i2","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.rulesBand }}","rightValue":"hardWin"}]}},"typeVersion":2.2},{"id":"a227c749-2c61-471f-98ab-542bb470aa10","name":"Write approved packages","type":"n8n-nodes-base.googleSheets","position":[5168,-32],"parameters":{"columns":{"value":{"run_at":"={{ $json.run_at }}","run_id":"={{ $json.run_id }}","best_url":"={{ $json.best_url }}","best_title":"={{ $json.best_title }}","cluster_id":"={{ $json.cluster_id }}","best_source":"={{ $json.best_source }}","rules_score":"={{ $json.rules_score }}","run_llm_calls":"={{ $json.run_jev_calls }}","run_signature":"={{ $json.run_signature }}","verdict_reason":"={{ $json.verdict_reason }}","run_articles_in":"={{ $json.run_articles_in }}","run_survived_rules":"={{ $json.run_survived_rules }}","run_unique_stories":"={{ $json.run_unique_stories }}","articles_in_cluster":"={{ $json.articles_in_cluster }}","corroborating_sources":"={{ $json.corroborating_sources }}"},"schema":[{"id":"run_id","type":"string","display":true,"removed":false,"required":false,"displayName":"run_id","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_at","type":"string","display":true,"removed":false,"required":false,"displayName":"run_at","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_signature","type":"string","display":true,"removed":false,"required":false,"displayName":"run_signature","defaultMatch":false,"canBeUsedToMatch":false},{"id":"cluster_id","type":"string","display":true,"removed":false,"required":false,"displayName":"cluster_id","defaultMatch":false,"canBeUsedToMatch":false},{"id":"best_title","type":"string","display":true,"removed":false,"required":false,"displayName":"best_title","defaultMatch":false,"canBeUsedToMatch":false},{"id":"best_source","type":"string","display":true,"removed":false,"required":false,"displayName":"best_source","defaultMatch":false,"canBeUsedToMatch":false},{"id":"best_url","type":"string","display":true,"removed":false,"required":false,"displayName":"best_url","defaultMatch":false,"canBeUsedToMatch":false},{"id":"rules_score","type":"string","display":true,"removed":false,"required":false,"displayName":"rules_score","defaultMatch":false,"canBeUsedToMatch":false},{"id":"verdict_reason","type":"string","display":true,"removed":false,"required":false,"displayName":"verdict_reason","defaultMatch":false,"canBeUsedToMatch":false},{"id":"corroborating_sources","type":"string","display":true,"removed":false,"required":false,"displayName":"corroborating_sources","defaultMatch":false,"canBeUsedToMatch":false},{"id":"articles_in_cluster","type":"string","display":true,"removed":false,"required":false,"displayName":"articles_in_cluster","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_articles_in","type":"string","display":true,"removed":false,"required":false,"displayName":"run_articles_in","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_survived_rules","type":"string","display":true,"removed":false,"required":false,"displayName":"run_survived_rules","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_unique_stories","type":"string","display":true,"removed":false,"required":false,"displayName":"run_unique_stories","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_llm_calls","type":"string","display":true,"removed":false,"required":false,"displayName":"run_llm_calls","defaultMatch":false,"canBeUsedToMatch":false}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{"useAppend":true},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.approvedTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"}},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"861c28a0-be7c-4539-a6ef-55bc2f0ec641","name":"Fetch live articles too?","type":"n8n-nodes-base.if","position":[528,448],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"lg1","operator":{"type":"boolean","operation":"equals"},"leftValue":"={{ $('Configure context').first().json.useLiveFetch }}","rightValue":true}]}},"typeVersion":2.2},{"id":"e6ee6297-03ed-4a22-a7b5-5b31c827eb09","name":"Merge sheet and live articles","type":"n8n-nodes-base.merge","position":[1360,-32],"parameters":{},"typeVersion":3.2},{"id":"a005b3ba-3bff-437e-8b15-baf366393226","name":"Map live articles to dataset shape","type":"n8n-nodes-base.set","position":[976,448],"parameters":{"options":{},"assignments":{"assignments":[{"id":"r1","name":"id","type":"string","value":"={{ 'live-' + ($itemIndex + 1) }}"},{"id":"r2","name":"title","type":"string","value":"={{ $json.title }}"},{"id":"r3","name":"summary","type":"string","value":"={{ $json.contentSnippet }}"},{"id":"r4","name":"source","type":"string","value":"FCA"},{"id":"r5","name":"url","type":"string","value":"={{ $json.link }}"},{"id":"r6","name":"published_at","type":"string","value":"={{ $json.isoDate || $json.pubDate }}"},{"id":"r7","name":"content_excerpt","type":"string","value":"={{ $json.contentSnippet }}"}]}},"typeVersion":3.4},{"id":"40c1a201-a6c1-40a6-b8e3-3e8acde7ea43","name":"Merge","type":"n8n-nodes-base.merge","position":[4496,160],"parameters":{},"typeVersion":3.2},{"id":"b3d39553-3824-4b1b-8264-f0d889177a18","name":"Start fresh this run?","type":"n8n-nodes-base.if","position":[240,64],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cg1","operator":{"type":"boolean","operation":"equals"},"leftValue":"={{ $('Configure context').first().json.clearBeforeRun }}","rightValue":true}]}},"typeVersion":2.2},{"id":"5edaff1b-e9bc-4641-8753-d40ce9aa83d6","name":"Continue after clear gate","type":"n8n-nodes-base.merge","position":[912,64],"parameters":{},"typeVersion":3.2},{"id":"966d060e-249d-47ee-ae37-78ac8ff7c74f","name":"Clear seen ledger","type":"n8n-nodes-base.googleSheets","position":[688,0],"parameters":{"operation":"clear","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.articlesTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"},"keepFirstRow":true},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"6e171e25-41da-4969-9433-c1456a2a488d","name":"Read seen ledger","type":"n8n-nodes-base.googleSheets","position":[1360,160],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.articlesTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"}},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7,"alwaysOutputData":true},{"id":"70fb2ade-f762-4023-a4d8-d0c3191587bb","name":"Drop already-seen URLs","type":"n8n-nodes-base.merge","position":[1584,160],"parameters":{"mode":"combine","options":{},"joinMode":"keepNonMatches","outputDataFrom":"input1","fieldsToMatchString":"url"},"typeVersion":3.2},{"id":"579d9584-9285-4910-ac98-f172fc4cf76b","name":"Record in seen ledger","type":"n8n-nodes-base.googleSheets","position":[2032,160],"parameters":{"columns":{"value":{"id":"={{ $json.id }}","url":"={{ $json.url }}","title":"={{ $json.title }}","reason":"={{ $json.reason }}","run_id":"={{ $json.run_id }}","source":"={{ $json.source }}","status":"={{ $json.status }}","summary":"={{ $json.summary }}","cluster_id":"={{ $json.cluster_id }}","rules_score":"={{ $json.rules_score }}","published_at":"={{ $json.published_at }}","content_excerpt":"={{ $json.content_excerpt }}"},"schema":[{"id":"id","type":"string","display":true,"removed":false,"required":false,"displayName":"id","defaultMatch":false,"canBeUsedToMatch":false},{"id":"title","type":"string","display":true,"removed":false,"required":false,"displayName":"title","defaultMatch":false,"canBeUsedToMatch":false},{"id":"summary","type":"string","display":true,"removed":false,"required":false,"displayName":"summary","defaultMatch":false,"canBeUsedToMatch":false},{"id":"source","type":"string","display":true,"removed":false,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":false},{"id":"url","type":"string","display":true,"removed":false,"required":false,"displayName":"url","defaultMatch":false,"canBeUsedToMatch":true},{"id":"published_at","type":"string","display":true,"removed":false,"required":false,"displayName":"published_at","defaultMatch":false,"canBeUsedToMatch":false},{"id":"content_excerpt","type":"string","display":true,"removed":false,"required":false,"displayName":"content_excerpt","defaultMatch":false,"canBeUsedToMatch":false},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":false},{"id":"rules_score","type":"string","display":true,"removed":false,"required":false,"displayName":"rules_score","defaultMatch":false,"canBeUsedToMatch":false},{"id":"reason","type":"string","display":true,"removed":false,"required":false,"displayName":"reason","defaultMatch":false,"canBeUsedToMatch":false},{"id":"cluster_id","type":"string","display":true,"removed":false,"required":false,"displayName":"cluster_id","defaultMatch":false,"canBeUsedToMatch":false},{"id":"run_id","type":"string","display":true,"removed":false,"required":false,"displayName":"run_id","defaultMatch":false,"canBeUsedToMatch":false}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{"useAppend":true},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.articlesTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"}},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"9f13400c-06cb-4d87-9383-39c456ccdd85","name":"Stamp pending status","type":"n8n-nodes-base.set","position":[1808,160],"parameters":{"options":{},"assignments":{"assignments":[{"id":"p1","name":"status","type":"string","value":"pending"},{"id":"p2","name":"rules_score","type":"string","value":""},{"id":"p3","name":"reason","type":"string","value":""},{"id":"p4","name":"cluster_id","type":"string","value":""},{"id":"p5","name":"run_id","type":"string","value":"={{ $execution.id }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"cab19259-ed19-4d74-840e-1e321c622538","name":"Compile article outcomes","type":"n8n-nodes-base.code","position":[5168,160],"parameters":{"jsCode":"// Writes every article's fate back to the seen ledger, matched by URL.\n//\n// Uses the outputs from the new weighted JEV scoring node rather than\n// reconstructing the old GPT judge verdict.\n//\n// Statuses:\n//   rejected_rules  - rejected before semantic/JEV processing\n//   approved_rules  - rules hard-win, skipped JEV\n//   approved_jev    - passed weighted JEV relevance scoring\n//   rejected_jev    - failed weighted JEV relevance scoring\n//   corroborating   - duplicate coverage of a primary story\n\nconst scoredArticles = $('Score with rules (Step 1)')\n  .all()\n  .map(item => item.json);\n\nconst storyPrimaries = $('Cluster stories (Step 2)')\n  .all()\n  .map(item => item.json);\n\n// This is the node that now calculates the weighted JEV relevance score\n// and outputs suggested_verdict, verdict_reason, judge_type, etc.\nconst scoredStories = $('Score and assemble ALL stories')\n  .all()\n  .map(item => item.json);\n\nconst config = $('Configure context').first().json;\nconst runId = String($execution.id || 'manual');\n\n\n// ---------------------------------------------------------\n// Build scored-story lookup by cluster\n// ---------------------------------------------------------\n\nconst scoredByCluster = {};\n\nfor (const scored of scoredStories) {\n  scoredByCluster[scored.cluster_id] = scored;\n}\n\n\n// ---------------------------------------------------------\n// Build outcome lookup by URL\n// ---------------------------------------------------------\n\nconst outcomeByUrl = {};\n\n\n// ---------------------------------------------------------\n// Rules rejects\n// ---------------------------------------------------------\n\nfor (const article of scoredArticles) {\n  if (article.rulesBand === 'reject') {\n    outcomeByUrl[article.url] = {\n      status: 'rejected_rules',\n      rules_score: article.rulesScore,\n      reason:\n        `Rules score ${article.rulesScore} below reject threshold ` +\n        `${config.rulesRejectThreshold}`,\n      cluster_id: '',\n    };\n  }\n}\n\n\n// ---------------------------------------------------------\n// Cluster primaries + corroborating articles\n// ---------------------------------------------------------\n\nfor (const story of storyPrimaries) {\n  const scored = scoredByCluster[story.clusterId];\n\n  let status;\n  let reason;\n\n  if (!scored) {\n    status = 'rejected_jev';\n    reason = 'Missing scoring result';\n  } else if (scored.judge_type === 'rules') {\n    status = 'approved_rules';\n    reason = scored.verdict_reason;\n  } else if (\n    scored.judge_type === 'jev' &&\n    scored.suggested_verdict === 'approved'\n  ) {\n    status = 'approved_jev';\n    reason = scored.verdict_reason;\n  } else {\n    status = 'rejected_jev';\n    reason = scored.verdict_reason || 'JEV relevance threshold not met';\n  }\n\n  outcomeByUrl[story.url] = {\n    status,\n    rules_score: story.rulesScore,\n    reason,\n    cluster_id: story.clusterId,\n  };\n\n\n  // -------------------------------------------------------\n  // Corroborating / duplicate coverage\n  // -------------------------------------------------------\n\n  for (const member of story.corroborating || []) {\n    const memberScored = scoredArticles.find(\n      candidate => candidate.url === member.url\n    );\n\n    outcomeByUrl[member.url] = {\n      status: 'corroborating',\n      rules_score: memberScored ? memberScored.rulesScore : '',\n      reason: `Duplicate coverage of: ${story.title}`,\n      cluster_id: story.clusterId,\n    };\n  }\n}\n\n\n// ---------------------------------------------------------\n// Output\n// ---------------------------------------------------------\n\nreturn Object.entries(outcomeByUrl).map(([url, outcome]) => ({\n  json: {\n    url,\n    ...outcome,\n    run_id: runId,\n  },\n}));"},"typeVersion":2},{"id":"a3f2bbbb-3546-4da9-bbd8-621ba75d5471","name":"Update ledger outcomes","type":"n8n-nodes-base.googleSheets","position":[5392,160],"parameters":{"columns":{"value":{"url":"={{ $json.url }}","reason":"={{ $json.reason }}","run_id":"={{ $json.run_id }}","status":"={{ $json.status }}","cluster_id":"={{ $json.cluster_id }}","rules_score":"={{ $json.rules_score }}"},"schema":[{"id":"id","type":"string","display":true,"removed":true,"required":false,"displayName":"id","defaultMatch":true,"canBeUsedToMatch":true},{"id":"title","type":"string","display":true,"removed":true,"required":false,"displayName":"title","defaultMatch":false,"canBeUsedToMatch":true},{"id":"summary","type":"string","display":true,"removed":true,"required":false,"displayName":"summary","defaultMatch":false,"canBeUsedToMatch":true},{"id":"source","type":"string","display":true,"removed":true,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"url","type":"string","display":true,"removed":false,"required":false,"displayName":"url","defaultMatch":false,"canBeUsedToMatch":true},{"id":"published_at","type":"string","display":true,"removed":true,"required":false,"displayName":"published_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"content_excerpt","type":"string","display":true,"removed":true,"required":false,"displayName":"content_excerpt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"rules_score","type":"string","display":true,"removed":false,"required":false,"displayName":"rules_score","defaultMatch":false,"canBeUsedToMatch":true},{"id":"reason","type":"string","display":true,"removed":false,"required":false,"displayName":"reason","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cluster_id","type":"string","display":true,"removed":false,"required":false,"displayName":"cluster_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"run_id","type":"string","display":true,"removed":false,"required":false,"displayName":"run_id","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["url"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Configure context').first().json.articlesTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Configure context').first().json.sheetDocumentId }}"}},"credentials":{"googleSheetsOAuth2Api":{"id":"4raGwq5cSo9OGBsz","name":"Stephen Google Sheets account"}},"typeVersion":4.7},{"id":"3a395d30-2fc4-469c-9e62-270daba83e1b","name":"Get article with firecrawl","type":"n8n-nodes-base.httpRequest","onError":"continueErrorOutput","position":[4048,16],"parameters":{"url":"https://api.firecrawl.dev/v2/scrape","method":"POST","options":{"batching":{"batch":{"batchSize":1,"batchInterval":6500}}},"jsonBody":"={\n  \"url\": \"{{ $json.url }}\",\n  \"formats\": [\n    \"markdown\"\n  ]\n}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpBearerAuth"},"credentials":{"httpBearerAuth":{"id":"ttcqexBboAbNAZMO","name":"Firecrawl Bearer"}},"retryOnFail":true,"typeVersion":4.5,"waitBetweenTries":5000},{"id":"ac6ef7a1-70fb-4711-a598-ce07c6ac67e4","name":"Judge relevance with Jev","type":"n8n-nodes-base.httpRequest","position":[4272,16],"parameters":{"url":"https://api.typesafe.ai/v1/systemone","method":"POST","options":{},"jsonBody":"={\n  \"state\": {\n    \"title\": {{ $('Needs LLM judgment?').item.json.title.toJsonString() }},\n    \"source\": {{ $('Needs LLM judgment?').item.json.source.toJsonString() }},\n    \"summary\": {{ $('Needs LLM judgment?').item.json.summary.toJsonString() }},\n    \"article_body\": {{ ($json.data?.markdown ?? '')\n  .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')        // images\n  .replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1')    // links -> text\n  .replace(/<[^>]*>/g, ' ')                    // HTML tags\n  .replace(/[#>*_~`|]+/g, ' ')                 // common markdown syntax\n  .replace(/\\n{3,}/g, '\\n\\n')                  // excessive newlines\n  .replace(/[ \\t]{2,}/g, ' ')                  // repeated spaces\n  .trim()\n  .toJsonString() }}\n  },\n  \"model\": \"jev-latest\",\n  \"questions\": {\n    \"regulatory_relevance\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure how directly the article concerns a current financial services regulatory development. Judge the substance of the article, not merely the presence of regulatory terminology. This question measures regulatory relevance only; do not reduce the score because the development is not specifically about fintech or payments, as that is measured separately.\",\n      \"criteria\": [\n        \"No meaningful connection to financial services regulation. Regulation is absent or merely incidental to the story.\",\n        \"Regulation is relevant to the story, but it is secondary to a primarily commercial, corporate, political, technological, consumer, or general industry story.\",\n        \"Financial services regulation is a meaningful part of the story, but the article is mainly background, commentary, emerging policy discussion, or an indirect development rather than a specific regulatory action or change.\",\n        \"The article is clearly about a specific regulatory development, consultation, policy proposal, supervisory expectation, enforcement action, rule, deadline, regulatory initiative, or change affecting financial services.\",\n        \"The article is directly centred on a concrete and consequential regulatory development, such as a new or changed requirement, formal regulatory action, major consultation or policy decision, enforcement action, implementation deadline, or material supervisory expectation.\"\n      ]\n    },\n    \"uk_applicability\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure how directly the regulatory development applies to the UK financial services environment. Judge jurisdiction and practical regulatory application. Do not assume something is UK-relevant merely because a UK firm could theoretically be interested in it.\",\n      \"criteria\": [\n        \"The development is not UK-related and has no meaningful identified application to UK financial services.\",\n        \"The development primarily concerns another jurisdiction and has only a weak or indirect connection to UK firms or UK regulation.\",\n        \"The development is international or cross-border and has meaningful implications for UK firms, but the regulatory action itself is not primarily UK-specific.\",\n        \"The development directly concerns the UK financial services market, UK-regulated firms, UK legislation, or UK regulatory policy.\",\n        \"The development is directly driven by or concerns a UK regulatory authority or framework, such as the FCA, PRA, Bank of England, Payment Systems Regulator, HM Treasury, or specific UK financial services legislation or regulatory requirements.\"\n      ]\n    },\n    \"fintech_payments_applicability\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure how directly the development matters to fintech, payments, e-money, digital banking, financial technology, crypto, stablecoin businesses, or closely related regulated firms. Do not penalise an article merely because it also affects traditional financial institutions. Score based on whether businesses in the target audience are meaningfully within the affected or interested population.\",\n      \"criteria\": [\n        \"No meaningful identified relevance to fintech, payments, e-money, digital banking, crypto, stablecoins, or closely related financial technology businesses.\",\n        \"The development concerns financial services generally, but fintech or payments firms have little specific exposure or are only incidentally affected.\",\n        \"The development has meaningful implications for some fintech, payments, or related firms, but the connection is indirect, limited to particular business models, or shared broadly across financial services.\",\n        \"Fintech, payments, e-money, digital banking, crypto, stablecoin, or closely related firms are clearly among the businesses affected by or expected to understand the development.\",\n        \"The development directly targets or materially changes the obligations, operations, risk, compliance, permissions, safeguarding, resilience, products, customer treatment, or regulatory status of fintech, payments, e-money, digital banking, crypto, stablecoin, or closely related firms.\"\n      ]\n    },\n    \"firm_actionability\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure the degree to which an affected firm should respond to, prepare for, monitor, assess, implement, or change something because of the development. Do not require an immediate compliance change for a story to score meaningfully: consultations, proposed rules, enforcement actions and emerging regulatory expectations can be actionable because firms should assess or monitor them.\",\n      \"criteria\": [\n        \"No identifiable action, assessment, preparation, or monitoring consequence for an affected firm.\",\n        \"Primarily informational. Relevant firms may find the development interesting, but there is little reason to change behaviour or actively assess it.\",\n        \"Relevant firms should monitor or assess the development because it may affect future requirements, risk, regulatory expectations, or business decisions, but there is not yet a clear operational response.\",\n        \"The development gives affected firms a clear reason to review, prepare, assess exposure, respond, or make operational or compliance plans.\",\n        \"The development creates a concrete or time-sensitive consequence requiring or strongly prompting affected firms to change controls, processes, disclosures, reporting, safeguarding, systems, customer treatment, permissions, governance, risk management, or compliance.\"\n      ]\n    },\n    \"regulatory_significance\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure the significance of the regulatory development for firms that are actually affected by it. Judge the magnitude of the regulatory consequence, not how dramatic the article sounds and not how broad the affected population is.\",\n      \"criteria\": [\n        \"No meaningful regulatory development is established.\",\n        \"A minor regulatory development with limited practical consequence for affected firms.\",\n        \"A meaningful development worth understanding or monitoring, but with limited expected impact on how affected firms operate or comply.\",\n        \"A material development that could meaningfully affect compliance, operations, risk, products, governance, permissions, costs, strategy, or customer treatment for affected firms.\",\n        \"A major development such as a substantial new regulatory regime, significant policy change, major enforcement action, important implementation deadline, or change with substantial consequences for affected firms.\"\n      ]\n    },\n    \"substantive_depth\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure only whether the supplied article contains enough substantive information to understand the development. This is a source-quality diagnostic, not a measure of whether the underlying story is relevant or important. Do not penalise a short article if it still clearly establishes what happened, who is affected, and why it matters.\",\n      \"criteria\": [\n        \"Essentially no usable substance. The supplied material does not establish what happened.\",\n        \"Very thin. A development is mentioned, but there is insufficient information to understand it reliably.\",\n        \"The article establishes the basic development and some context, but provides limited detail about affected parties, consequences, requirements, or implications.\",\n        \"The article provides substantive coverage of what happened, relevant context, affected parties, and meaningful implications.\",\n        \"The article provides detailed and specific coverage of the development, affected parties, consequences or requirements, important context, and relevant dates or implementation details where applicable.\"\n      ]\n    },\n    \"content_quality\": {\n      \"type\": \"choice\",\n      \"instructions\": \"Classify the primary nature of the article. Choose the category that best describes what the article is fundamentally about. Classify based on the dominant purpose and substance of the article, not isolated words or secondary sections. A regulatory article that contains background explanation should remain a regulatory article.\",\n      \"criteria\": {\n        \"substantive_regulatory_development\": \"Reports or explains a concrete current regulatory policy, rule, consultation, supervisory expectation, enforcement action, regulatory deadline, regulatory initiative, legislative change, or other substantive regulatory development.\",\n        \"regulatory_analysis\": \"Provides substantive analysis or commentary about a genuine current or emerging regulatory development and its consequences for firms.\",\n        \"general_fintech_news\": \"Primarily fintech, payments, banking, crypto, business, or technology news without a meaningful regulatory development or regulatory consequence.\",\n        \"consumer_finance\": \"Primarily consumer-facing money advice, personal finance guidance, product comparisons, rates, savings, mortgages, investments, or similar consumer content rather than industry regulatory change.\",\n        \"product_marketing\": \"Primarily promotes or announces a commercial product, service, company offering, partnership, launch, or marketing proposition without a substantive regulatory development.\",\n        \"appointment_people_news\": \"Primarily reports an appointment, hire, promotion, departure, personnel change, or similar corporate people news.\",\n        \"evergreen_background\": \"Primarily encyclopaedic, educational, definitional, historical, or evergreen material rather than reporting or analysing a current or emerging regulatory development.\",\n        \"thin_content\": \"The supplied content contains too little substantive information to establish what development occurred or what the story is actually about.\",\n        \"other_off_niche\": \"The article is fundamentally outside financial services regulatory change and does not fit another rejection category.\"\n      }\n    },\n    \"client_content_value\": {\n      \"type\": \"score\",\n      \"instructions\": \"Measure how useful the underlying story would be as the basis for client-facing content aimed at regulatory, compliance, operational, risk, product, or strategic decision-makers within UK fintech and payments firms. Judge the value of communicating the development, not the writing quality of the source article. Consider whether the target audience would reasonably benefit from knowing what happened and why it matters.\",\n      \"criteria\": [\n        \"No meaningful client-facing content value for this audience.\",\n        \"Weak content candidate. There is some topical connection, but little useful regulatory insight or consequence for the target audience.\",\n        \"Potentially useful content. The story has a legitimate regulatory angle or implication, but is relatively narrow, indirect, low-impact, or relevant only to part of the target audience.\",\n        \"Good content candidate. There is a clear regulatory development or analysis with useful implications that relevant members of the target audience should understand.\",\n        \"Strong content candidate. The development is timely and substantive with clear consequences, decisions, risks, obligations, deadlines, strategic implications, or actions that are highly useful to the target audience.\"\n      ]\n    }\n  }\n}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpBearerAuth"},"credentials":{"httpBearerAuth":{"id":"TH0V6J2SWVpBq2pp","name":"TypeSafe Bearer"}},"retryOnFail":true,"typeVersion":4.5,"waitBetweenTries":5000},{"id":"198d5751-e3ef-4983-9d9d-1dd30375c4f8","name":"Live fetch (FCA Press Release)","type":"n8n-nodes-base.rssFeedRead","position":[752,448],"parameters":{"url":"https://www.fca.org.uk/rss.xml","options":{}},"typeVersion":1.1},{"id":"2573f22c-b84e-4669-9f41-6b04054db686","name":"No Operation, do nothing","type":"n8n-nodes-base.noOp","position":[5168,352],"parameters":{},"typeVersion":1},{"id":"97863bf1-9038-44cb-aff2-f77df022cd57","name":"If relevant or hard win","type":"n8n-nodes-base.if","position":[4944,160],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"or","conditions":[{"id":"0a3bfc13-d9d6-4de3-968c-330f3df7ccbd","operator":{"type":"number","operation":"gt"},"leftValue":"={{ $json.relevance_score }}","rightValue":"={{ $json.relevance_threshold }}"},{"id":"a077b1bc-a5e2-4f2d-adf4-c5dcbc781305","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.rules_band }}","rightValue":"hardWin"}]}},"typeVersion":2.3},{"id":"84b0d2b9-5851-4397-b980-68cfe30b228c","name":"Sticky config","type":"n8n-nodes-base.stickyNote","position":[-800,-384],"parameters":{"color":4,"width":480,"height":812,"content":"## Edit knobs here, nothing else\nMost pipeline tuning lives in Set Workflow Context:\n- **sheetDocumentId / sourceTab / articlesTab / approvedTab** - the spreadsheet, incoming-feed tab, seen-articles ledger tab and output tab\n- **rulesKeywords** - term-to-weight map for Step 1; a headline hit counts double a body hit (word-boundary matched)\n- **sourceWeights** - domain-to-weight map (live articles carry their feed's domain as source); unknown domains score 0\n- **rulesRejectThreshold** - score below this = rejected immediately\n- **rulesHardWinThreshold** - score at or above this is strong enough to bypass JEV entirely\n- **clusterSimilarityThreshold** - cosine similarity at which two articles are treated as the same story; raise it and clusters fragment, lower it and distinct stories merge\n- **embeddingProvider** - huggingface or openai; both branches emit the same shape\n- **hfEmbeddingModel / openaiEmbeddingModel** - embedding model used by each provider\n- **clearBeforeRun** - true wipes the ledger and output tabs (headers always survive) first for a clean demo run; false keeps history, and articles already in the ledger are dropped before further processing\n- **rssFeedUrls** - JSON array of RSS feed URLs; add as many as you like\n- **useLiveFetch** - true pulls every feed in `rssFeedUrls` into the run; false reads only the Source Articles tab\n- **nicheContext** - the overall definition of the regulatory niche used by the pipeline\n\nJEV's relevance dimensions and scoring criteria live in the **Judge relevance with JEV** request. The final weights and approval threshold live in the **Score & assemble stories** Code node, keeping the model's measurements separate from the workflow's business rules."},"typeVersion":1},{"id":"40138ee6-862d-4217-a4fa-c7422360d570","name":"Sticky howitworks","type":"n8n-nodes-base.stickyNote","position":[-1456,-832],"parameters":{"width":620,"height":1264,"content":"# How It Works 🧠\nTurns a noisy news feed into a deduplicated, approved content package - using increasingly expensive processing only when a story earns it.\n\nThree escalating-cost steps:\n1. **Rules tier (free)** - keyword + source scoring kills the obvious noise; articles above the hard-win threshold skip further relevance scoring entirely\n2. **Semantic dedup (pennies)** - embeddings + cosine similarity cluster outlets covering the same story; one primary per cluster proceeds\n3. **JEV relevance scoring** - JEV scores each unique, ambiguous story across regulatory relevance, UK applicability, fintech/payments applicability, regulatory significance, firm actionability and client content value. **JEV never sees the same story twice.**\n\nInstead of asking an LLM for a black-box yes/no verdict, the workflow turns JEV's structured scores into a weighted relevance score out of 100. The final routing is deterministic and easy to tune.\n\nOne row per approved story lands in the Approved Package tab: best article, every other outlet's angle as corroborating sources, relevance scoring and run counts. Every article's fate is written back to the Articles ledger with the reason - and already-seen URLs are dropped before any processing is spent on them, so repeat runs stay cheap.\n\n## Setup (~5 minutes)\n1. **Credentials** - create Google Sheets (OAuth), Firecrawl, Hugging Face (free token) and Typesafe/JEV credentials, then attach them to the relevant Sheets, embedding and JEV nodes\n2. **Sheet** - copy the starter sheet linked in the template description (File → Make a copy), or run the starter seed workflow from the GitHub repo\n3. **Set Workflow Context** - paste your spreadsheet ID into `sheetDocumentId` and put your feeds in `rssFeedUrls`\n4. **Run** - live headlines flow through the three steps into the Approved Package tab\n\n**Adapt it to your niche** by editing the rules and JEV scoring criteria to describe what matters for your use case.\n\n## Starter Google Sheet:\nhttps://docs.google.com/spreadsheets/d/1Cmhh8FO9cljzfjni396o442rmLR31qJ1EtGcVFpAV6w/edit?usp=sharing\n\n## Data sources\nTwo ways to feed the pipeline:\n- **Live RSS (default)** - every URL in `rssFeedUrls` is fetched each run; an article's `source` is its domain, so key `sourceWeights` by domain (e.g. `techcrunch.com`)\n- **Source Articles tab** - populate it from another workflow (or any tool that writes rows in its seven-column shape: id, title, summary, source, url, published_at, content_excerpt) and the pipeline categorises whatever lands there\n\nThe Articles ledger drops anything already seen, so repeat runs cost nothing."},"typeVersion":1},{"id":"4db644b1-6603-43f0-99bf-a99db11071dd","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-256,-96],"parameters":{"color":7,"width":416,"height":528,"content":"## Triggers and context\n\nStarts the pipeline manually or on a daily schedule, then sets the spreadsheet, tab, feed, and run configuration used by downstream nodes."},"typeVersion":1},{"id":"8d315598-0303-40c5-93f5-c3be78d3821a","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[192,-224],"parameters":{"color":7,"width":864,"height":480,"content":"## Fresh run cleanup\n\nChecks whether this run should start fresh, clears prior approved packages and the seen ledger when requested, then rejoins the normal flow."},"typeVersion":1},{"id":"1b80f22b-3bd3-4d6b-9501-ec1e34db4d48","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[416,320],"parameters":{"color":7,"width":864,"height":304,"content":"## Live RSS intake\n\nOptionally fetches live articles by splitting configured feed URLs, reading each RSS feed, and mapping results into the same article shape as the sheet data."},"typeVersion":1},{"id":"f8a7d2d0-f2c8-46eb-adbd-9182e5eecede","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[1104,-240],"parameters":{"color":7,"width":416,"height":544,"content":"## Read source records\n\nReads source articles from Google Sheets, appends any mapped live articles, and reads the existing seen ledger for deduplication."},"typeVersion":1},{"id":"c5be6e01-5e41-426f-9e09-5142ec6ad5fd","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[1536,-16],"parameters":{"color":7,"width":640,"height":320,"content":"## Deduplicate new URLs\n\nDrops articles whose URLs are already in the ledger, stamps the remaining items with pending defaults, and records them as seen before scoring."},"typeVersion":1},{"id":"286bc389-fc4a-4ed1-b155-97e9229708ef","name":"Sticky Note6","type":"n8n-nodes-base.stickyNote","position":[2208,-16],"parameters":{"color":7,"width":640,"height":320,"content":"## Rule score candidates\n\nApplies deterministic rule-based scoring, removes rejected noise, and collects the surviving items into a batch for embedding."},"typeVersion":1},{"id":"14ec7f0d-b42f-41e2-807e-e9495fa57196","name":"Sticky Note7","type":"n8n-nodes-base.stickyNote","position":[2880,-192],"parameters":{"color":7,"width":640,"height":528,"content":"## Generate article embeddings\n\nSelects an embedding provider, sends the batch to Hugging Face or OpenAI, and normalizes either provider’s vector response into a common vectors field."},"typeVersion":1},{"id":"50adffbe-0465-4d33-9d79-ad941105f215","name":"Sticky Note8","type":"n8n-nodes-base.stickyNote","position":[3552,-16],"parameters":{"color":7,"width":416,"height":320,"content":"## Cluster and route\n\nClusters embedded articles to group near-duplicate coverage of the same story, then decides which clusters require LLM judgment."},"typeVersion":1},{"id":"deb06edb-2f41-466c-8192-63817d87c74d","name":"Sticky Note9","type":"n8n-nodes-base.stickyNote","position":[4240,-576],"parameters":{"color":7,"width":400,"height":896,"content":"## JEV relevance scoring\n\nReplaces the previous GPT yes/no relevance judge with structured scoring.\n\nFor each unique, ambiguous story, the full article is fetched and JEV independently scores:\n- **Regulatory relevance**\n- **UK applicability**\n- **Fintech/payments applicability**\n- **Regulatory significance**\n- **Firm actionability**\n- **Client content value**\n\nIt also scores **substantive depth** for diagnostics and classifies the article's **content quality**.\n\nJEV does not decide whether the article is approved. It measures the article; the workflow makes the decision deterministically from those measurements."},"typeVersion":1},{"id":"18aefe2b-b75e-4060-9f36-b250f184d570","name":"Sticky Note10","type":"n8n-nodes-base.stickyNote","position":[4656,-576],"parameters":{"color":7,"width":416,"height":896,"content":"## Weighted relevance scoring\n\nCombines rules hard-wins with the stories scored by JEV.\n\nFor JEV-scored stories, the Code node converts the 0-4 scores into a weighted relevance score out of 100:\n\n- **Regulatory relevance:** 30%\n- **UK applicability:** 20%\n- **Fintech/payments applicability:** 15%\n- **Regulatory significance:** 15%\n- **Firm actionability:** 10%\n- **Client content value:** 10%\n\nSubstantive depth is diagnostic only and content quality remains a classification rather than contributing points.\n\nThe node outputs every story and its component scores, weighted contributions, confidence values and overall relevance score. The following conditional node then routes stories above the relevance threshold - plus rules hard-wins - into the approved path.\n\nThis keeps the final decision transparent: **JEV measures; the workflow decides.**"},"typeVersion":1},{"id":"7bab08d1-032c-47f3-8418-451bdb20a147","name":"Sticky Note11","type":"n8n-nodes-base.stickyNote","position":[5104,-240],"parameters":{"color":7,"height":384,"content":"## Write approved packages\n\nWrites the assembled approved story packages to the configured approved output sheet."},"typeVersion":1},{"id":"0f8fec7c-93ee-42c0-b9e4-ebb124137067","name":"Sticky Note12","type":"n8n-nodes-base.stickyNote","position":[5360,0],"parameters":{"color":7,"width":368,"height":352,"content":"## Update outcome ledger\n\nCompiles every article’s final fate and updates the seen ledger so future runs can skip or report on previously processed URLs."},"typeVersion":1},{"id":"e2cd6aec-4c4a-4dca-86ae-d3439c340b17","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[4240,-2800],"parameters":{"width":880,"height":2192,"content":"Yep. I’d keep the descriptions, but put a **tiny JSON example directly underneath each one**. That makes the JEV request structure much easier to reverse-engineer.\n\n## How JEV questions work\n\nJEV replaces open-ended prompting with structured questions. Each question in the `questions` object uses one of three output types:\n\n### `score` - measure something on a scale\n\nUse `score` when there are ordered levels of quality, relevance or importance.\n\nFor example, this workflow scores how directly an article concerns financial regulation:\n\n```json\n\"regulatory_relevance\": {\n  \"type\": \"score\",\n  \"question\": \"How directly does this article concern a current financial services regulatory development?\",\n  \"criteria\": [\n    \"No meaningful regulatory connection\",\n    \"Regulation is relevant but secondary\",\n    \"Meaningful regulatory relevance, but mostly background or indirect\",\n    \"Clearly concerns a specific regulatory development\",\n    \"Directly centred on a concrete and consequential regulatory development\"\n  ]\n}\n```\n\nJEV returns a score from **0-4**, plus confidence and the probability distribution across the possible scores.\n\n### `choice` - classify into categories\n\nUse `choice` when the answer should be one of several named categories.\n\nThis workflow uses it to classify the dominant type of article:\n\n```json\n\"content_quality\": {\n  \"type\": \"choice\",\n  \"question\": \"What is the dominant purpose and substance of this article?\",\n  \"choices\": [\n    \"substantive_regulatory_development\",\n    \"regulatory_analysis\",\n    \"general_fintech_news\",\n    \"consumer_finance\",\n    \"product_marketing\",\n    \"appointment_people_news\",\n    \"evergreen_background\",\n    \"thin_content\",\n    \"other_off_niche\"\n  ]\n}\n```\n\nJEV returns the selected `choice`, its confidence and the probability distribution across the available choices.\n\n### `noul` - probabilistic yes/no\n\nUse `noul` for a genuinely binary question.\n\nFor example, an earlier version of this workflow asked JEV to make the final relevance decision directly:\n\n```json\n\"relevant\": {\n  \"type\": \"noul\",\n  \"question\": \"Is this article relevant enough to become client-facing content for this niche?\"\n}\n```\n\nUnlike a normal boolean, the result is probabilistic rather than simply `true` or `false`.\n\nWe deliberately removed this from the final workflow. JEV now measures the individual dimensions with `score` and `choice`, while n8n calculates the final weighted relevance score deterministically.\n\n### What does JEV actually read?\n\nThe `state` object contains the evidence JEV evaluates:\n\n```json\n\"state\": {\n  \"title\": \"{{ article title }}\",\n  \"source\": \"{{ article source }}\",\n  \"summary\": \"{{ article summary }}\",\n  \"article_body\": \"{{ full article body }}\"\n}\n```\n\nYou can replace these fields with whatever information your own workflow needs JEV to evaluate.\n\nThe basic structure is:\n\n**`state` = what JEV reads → `questions` = what JEV measures → n8n = what you do with the measurements**\n\nSo when adapting this workflow to another niche, you're not really rewriting a prompt. You're defining the evidence JEV receives, the questions it should measure, and the deterministic logic that acts on the results."},"typeVersion":1},{"id":"217f9752-c0a6-4b25-b477-81310721dfea","name":"Set error","type":"n8n-nodes-base.set","position":[4272,272],"parameters":{"options":{},"assignments":{"assignments":[{"id":"5c29bde7-5399-49bf-9e5d-6b15e5ff3a3f","name":"title","type":"string","value":"={{ $('Cluster stories (Step 2)').item.json.title }}"},{"id":"034b8abf-e5c9-477a-863e-717d8dd6f544","name":"url","type":"string","value":"={{ $('Cluster stories (Step 2)').item.json.url }}"},{"id":"5f2fce81-9d64-4a4e-a0f4-ab0b561e456b","name":"error","type":"string","value":"={{ $json.error }}"}]}},"typeVersion":3.5},{"id":"4fe68118-32a4-4204-8f96-5fffa2e49b85","name":"Score and assemble ALL stories","type":"n8n-nodes-base.code","position":[4720,160],"parameters":{"jsCode":"// Score and assemble ALL stories.\n//\n// Rules hard-wins bypass JEV.\n// All other stories are scored using JEV outputs.\n//\n// This node DOES NOT filter stories.\n// Use an IF node afterwards to decide what continues.\n//\n// Weighted relevance model:\n//   Regulatory relevance            30%\n//   UK applicability                20%\n//   Fintech/payments applicability  15%\n//   Regulatory significance         15%\n//   Firm actionability              10%\n//   Client content value            10%\n//\n// Substantive depth is diagnostic only.\n// Content quality is classification only.\n\nconst APPROVAL_THRESHOLD = 60;\n\nconst WEIGHTS = {\n  regulatory_relevance: 30,\n  uk_applicability: 20,\n  fintech_payments_applicability: 15,\n  regulatory_significance: 15,\n  firm_actionability: 10,\n  client_content_value: 10,\n};\n\nconst REJECT_CATEGORIES = new Set([\n  'consumer_finance',\n  'product_marketing',\n  'appointment_people_news',\n  'evergreen_background',\n  'thin_content',\n  'other_off_niche',\n]);\n\nconst CATEGORY_REJECT_CONFIDENCE = 0.75;\n\n\n// ---------------------------------------------------------\n// Input stories\n// ---------------------------------------------------------\n\nconst storyPrimaries = $('Cluster stories (Step 2)')\n  .all()\n  .map(item => item.json);\n\nconst judgedPrimaries = storyPrimaries.filter(\n  story => story.rulesBand !== 'hardWin'\n);\n\n\n// ---------------------------------------------------------\n// Read JEV outputs\n// ---------------------------------------------------------\n\nlet judgeOutputs = [];\n\nif (judgedPrimaries.length > 0) {\n  try {\n    judgeOutputs = $('Judge relevance with Jev')\n      .all()\n      .map(item => item.json);\n  } catch (error) {\n    throw new Error(\n      `Could not read outputs from \"Judge relevance with Jev\": ${error.message}`\n    );\n  }\n}\n\n\n// ---------------------------------------------------------\n// Normalise JEV response\n// ---------------------------------------------------------\n\nfunction getJevResult(raw) {\n  if (!raw) return null;\n\n  let result = raw.output ?? raw;\n\n  if (typeof result === 'string') {\n    try {\n      result = JSON.parse(result);\n    } catch {\n      return null;\n    }\n  }\n\n  if (!result || typeof result !== 'object') {\n    return null;\n  }\n\n  return result.answers ?? result;\n}\n\n\n// ---------------------------------------------------------\n// JEV helpers\n// ---------------------------------------------------------\n\nfunction getScore(answers, key) {\n  const answer = answers?.[key];\n\n  if (answer == null) return null;\n\n  if (typeof answer.score === 'number') {\n    return answer.score;\n  }\n\n  if (typeof answer === 'number') {\n    return answer;\n  }\n\n  return null;\n}\n\n\nfunction getConfidence(answers, key) {\n  const confidence = answers?.[key]?.confidence;\n\n  return typeof confidence === 'number'\n    ? confidence\n    : null;\n}\n\n\nfunction getChoice(answers, key) {\n  const answer = answers?.[key];\n\n  if (answer == null) return null;\n\n  if (typeof answer.choice === 'string') {\n    return answer.choice;\n  }\n\n  if (typeof answer === 'string') {\n    return answer;\n  }\n\n  return null;\n}\n\n\n// ---------------------------------------------------------\n// Weighted relevance calculation\n// ---------------------------------------------------------\n\nfunction calculateRelevance(answers) {\n  const scores = {\n    regulatory_relevance:\n      getScore(answers, 'regulatory_relevance'),\n\n    uk_applicability:\n      getScore(answers, 'uk_applicability'),\n\n    fintech_payments_applicability:\n      getScore(answers, 'fintech_payments_applicability'),\n\n    regulatory_significance:\n      getScore(answers, 'regulatory_significance'),\n\n    firm_actionability:\n      getScore(answers, 'firm_actionability'),\n\n    client_content_value:\n      getScore(answers, 'client_content_value'),\n  };\n\n  const missingScores = Object.entries(scores)\n    .filter(([, value]) => typeof value !== 'number')\n    .map(([key]) => key);\n\n  if (missingScores.length > 0) {\n    return {\n      valid: false,\n      score: null,\n      scores,\n      missingScores,\n    };\n  }\n\n  let total = 0;\n\n  for (const [key, weight] of Object.entries(WEIGHTS)) {\n    total += (scores[key] / 4) * weight;\n  }\n\n  return {\n    valid: true,\n    score: Math.round(total * 100) / 100,\n    scores,\n    missingScores: [],\n  };\n}\n\n\n// ---------------------------------------------------------\n// Score band\n// ---------------------------------------------------------\n\nfunction getScoreBand(score) {\n  if (score === null) return 'invalid';\n  if (score < 40) return 'reject';\n  if (score < 60) return 'weak';\n  if (score < 75) return 'candidate';\n  return 'strong';\n}\n\n\n// ---------------------------------------------------------\n// Build result lookup\n// ---------------------------------------------------------\n\nconst verdictByCluster = {};\n\n\n// ---------------------------------------------------------\n// Rules hard wins\n// ---------------------------------------------------------\n\nfor (const story of storyPrimaries) {\n  if (story.rulesBand === 'hardWin') {\n    verdictByCluster[story.clusterId] = {\n      suggestedVerdict: 'approved',\n      reason: 'Rules hard win - skipped JEV',\n      judgeType: 'rules',\n\n      relevanceScore: null,\n      scoreBand: 'rules_hard_win',\n\n      categoryHardReject: false,\n\n      jev: null,\n    };\n  }\n}\n\n\n// ---------------------------------------------------------\n// Process JEV results\n// ---------------------------------------------------------\n\njudgedPrimaries.forEach((story, judgeIndex) => {\n  const rawJudgeOutput = judgeOutputs[judgeIndex];\n  const answers = getJevResult(rawJudgeOutput);\n\n  if (!answers) {\n    verdictByCluster[story.clusterId] = {\n      suggestedVerdict: 'rejected',\n      reason: 'No valid JEV output received',\n      judgeType: 'jev',\n\n      relevanceScore: null,\n      scoreBand: 'invalid',\n\n      categoryHardReject: false,\n\n      jev: null,\n    };\n\n    return;\n  }\n\n\n  // -------------------------------------------------------\n  // Calculate weighted relevance\n  // -------------------------------------------------------\n\n  const relevance = calculateRelevance(answers);\n\n  if (!relevance.valid) {\n    verdictByCluster[story.clusterId] = {\n      suggestedVerdict: 'rejected',\n\n      reason:\n        `Incomplete JEV output - missing scores: ` +\n        relevance.missingScores.join(', '),\n\n      judgeType: 'jev',\n\n      relevanceScore: null,\n      scoreBand: 'invalid',\n\n      categoryHardReject: false,\n\n      jev: answers,\n    };\n\n    return;\n  }\n\n\n  // -------------------------------------------------------\n  // Content classification\n  // -------------------------------------------------------\n\n  const contentQuality =\n    getChoice(answers, 'content_quality');\n\n  const contentQualityConfidence =\n    getConfidence(answers, 'content_quality');\n\n  const categoryHardReject =\n    REJECT_CATEGORIES.has(contentQuality) &&\n    contentQualityConfidence !== null &&\n    contentQualityConfidence >= CATEGORY_REJECT_CONFIDENCE;\n\n\n  // -------------------------------------------------------\n  // Suggested decision\n  // -------------------------------------------------------\n\n  const passesScore =\n    relevance.score >= APPROVAL_THRESHOLD;\n\n  const suggestedApproved =\n    passesScore && !categoryHardReject;\n\n  const scoreBand =\n    getScoreBand(relevance.score);\n\n\n  // -------------------------------------------------------\n  // Human-readable diagnostic\n  // -------------------------------------------------------\n\n  let reason;\n\n  if (categoryHardReject) {\n    reason =\n      `High-confidence rejection classification: ` +\n      `${contentQuality} ` +\n      `(${Math.round(contentQualityConfidence * 100)}% confidence). ` +\n      `Weighted relevance score: ${relevance.score}/100`;\n  } else if (!passesScore) {\n    reason =\n      `Weighted relevance score ${relevance.score}/100 ` +\n      `is below threshold ${APPROVAL_THRESHOLD}/100. ` +\n      `Content classification: ${contentQuality || 'unknown'}`;\n  } else {\n    reason =\n      `Weighted relevance score ${relevance.score}/100 ` +\n      `meets threshold ${APPROVAL_THRESHOLD}/100. ` +\n      `Content classification: ${contentQuality || 'unknown'}`;\n  }\n\n\n  verdictByCluster[story.clusterId] = {\n    suggestedVerdict:\n      suggestedApproved ? 'approved' : 'rejected',\n\n    reason,\n    judgeType: 'jev',\n\n    relevanceScore: relevance.score,\n    scoreBand,\n\n    categoryHardReject,\n\n    jev: answers,\n  };\n});\n\n\n// ---------------------------------------------------------\n// Run-level metrics\n// ---------------------------------------------------------\n\nconst articlesIn =\n  $('Read source articles').all().length;\n\nconst survivedRules =\n  $('Drop rejected noise').all().length;\n\nconst runId =\n  $execution.id || 'manual';\n\nconst runAt =\n  new Date().toISOString();\n\nconst runSignature =\n  `${articlesIn}-${survivedRules}-${storyPrimaries.length}-${judgedPrimaries.length}`;\n\nconst rulesHardWins =\n  storyPrimaries.filter(\n    story => story.rulesBand === 'hardWin'\n  ).length;\n\n\n// ---------------------------------------------------------\n// Assemble ALL stories\n// ---------------------------------------------------------\n\nconst packageRows = [];\n\nfor (const story of storyPrimaries) {\n\n  const clusterVerdict =\n    verdictByCluster[story.clusterId] || {\n      suggestedVerdict: 'rejected',\n      reason: 'Missing scoring result',\n      judgeType: 'unknown',\n\n      relevanceScore: null,\n      scoreBand: 'invalid',\n\n      categoryHardReject: false,\n\n      jev: null,\n    };\n\n\n  const corroborating =\n    (story.corroborating || [])\n      .map(member =>\n        `${member.title} - ${member.source} (${member.url})`\n      )\n      .join(' | ');\n\n\n  const jev = clusterVerdict.jev;\n\n\n  // -------------------------------------------------------\n  // JEV scores\n  // -------------------------------------------------------\n\n  const regulatoryRelevance =\n    getScore(jev, 'regulatory_relevance');\n\n  const ukApplicability =\n    getScore(jev, 'uk_applicability');\n\n  const fintechApplicability =\n    getScore(jev, 'fintech_payments_applicability');\n\n  const firmActionability =\n    getScore(jev, 'firm_actionability');\n\n  const regulatorySignificance =\n    getScore(jev, 'regulatory_significance');\n\n  const substantiveDepth =\n    getScore(jev, 'substantive_depth');\n\n  const clientContentValue =\n    getScore(jev, 'client_content_value');\n\n  const contentQuality =\n    getChoice(jev, 'content_quality');\n\n  const contentQualityConfidence =\n    getConfidence(jev, 'content_quality');\n\n\n  // -------------------------------------------------------\n  // Weighted contributions\n  // -------------------------------------------------------\n\n  const regulatoryRelevancePoints =\n    regulatoryRelevance !== null\n      ? Math.round(\n          ((regulatoryRelevance / 4) *\n            WEIGHTS.regulatory_relevance) * 100\n        ) / 100\n      : null;\n\n  const ukApplicabilityPoints =\n    ukApplicability !== null\n      ? Math.round(\n          ((ukApplicability / 4) *\n            WEIGHTS.uk_applicability) * 100\n        ) / 100\n      : null;\n\n  const fintechApplicabilityPoints =\n    fintechApplicability !== null\n      ? Math.round(\n          ((fintechApplicability / 4) *\n            WEIGHTS.fintech_payments_applicability) * 100\n        ) / 100\n      : null;\n\n  const regulatorySignificancePoints =\n    regulatorySignificance !== null\n      ? Math.round(\n          ((regulatorySignificance / 4) *\n            WEIGHTS.regulatory_significance) * 100\n        ) / 100\n      : null;\n\n  const firmActionabilityPoints =\n    firmActionability !== null\n      ? Math.round(\n          ((firmActionability / 4) *\n            WEIGHTS.firm_actionability) * 100\n        ) / 100\n      : null;\n\n  const clientContentValuePoints =\n    clientContentValue !== null\n      ? Math.round(\n          ((clientContentValue / 4) *\n            WEIGHTS.client_content_value) * 100\n        ) / 100\n      : null;\n\n\n  // -------------------------------------------------------\n  // Output ALL stories\n  // -------------------------------------------------------\n\n  packageRows.push({\n    json: {\n\n      run_id: runId,\n      run_at: runAt,\n      run_signature: runSignature,\n\n      cluster_id: story.clusterId,\n\n      best_title: story.title,\n      best_source: story.source,\n      best_url: story.url,\n\n\n      // Rules stage\n      rules_score: story.rulesScore,\n      rules_band: story.rulesBand,\n\n\n      // Suggested relevance decision\n      judge_type: clusterVerdict.judgeType,\n\n      relevance_score:\n        clusterVerdict.relevanceScore,\n\n      relevance_score_band:\n        clusterVerdict.scoreBand,\n\n      relevance_threshold:\n        APPROVAL_THRESHOLD,\n\n      suggested_verdict:\n        clusterVerdict.suggestedVerdict,\n\n      verdict_reason:\n        clusterVerdict.reason,\n\n\n      // JEV classification\n      jev_content_quality:\n        contentQuality,\n\n      jev_content_quality_confidence:\n        contentQualityConfidence,\n\n      jev_category_hard_reject:\n        clusterVerdict.categoryHardReject,\n\n\n      // JEV raw component scores\n      jev_regulatory_relevance:\n        regulatoryRelevance,\n\n      jev_uk_applicability:\n        ukApplicability,\n\n      jev_fintech_payments_applicability:\n        fintechApplicability,\n\n      jev_regulatory_significance:\n        regulatorySignificance,\n\n      jev_firm_actionability:\n        firmActionability,\n\n      jev_substantive_depth:\n        substantiveDepth,\n\n      jev_client_content_value:\n        clientContentValue,\n\n\n      // Weighted point contributions\n      relevance_points_regulatory:\n        regulatoryRelevancePoints,\n\n      relevance_points_uk:\n        ukApplicabilityPoints,\n\n      relevance_points_fintech_payments:\n        fintechApplicabilityPoints,\n\n      relevance_points_regulatory_significance:\n        regulatorySignificancePoints,\n\n      relevance_points_firm_actionability:\n        firmActionabilityPoints,\n\n      relevance_points_client_content_value:\n        clientContentValuePoints,\n\n\n      // JEV confidence values\n      jev_regulatory_relevance_confidence:\n        getConfidence(jev, 'regulatory_relevance'),\n\n      jev_uk_applicability_confidence:\n        getConfidence(jev, 'uk_applicability'),\n\n      jev_fintech_payments_applicability_confidence:\n        getConfidence(\n          jev,\n          'fintech_payments_applicability'\n        ),\n\n      jev_regulatory_significance_confidence:\n        getConfidence(jev, 'regulatory_significance'),\n\n      jev_firm_actionability_confidence:\n        getConfidence(jev, 'firm_actionability'),\n\n      jev_substantive_depth_confidence:\n        getConfidence(jev, 'substantive_depth'),\n\n      jev_client_content_value_confidence:\n        getConfidence(jev, 'client_content_value'),\n\n\n      // Cluster information\n      corroborating_sources:\n        corroborating ||\n        'none - single-source story',\n\n      articles_in_cluster:\n        story.clusterSize,\n\n\n      // Run metrics\n      run_articles_in:\n        articlesIn,\n\n      run_survived_rules:\n        survivedRules,\n\n      run_unique_stories:\n        storyPrimaries.length,\n\n      run_jev_calls:\n        judgedPrimaries.length,\n\n      run_rules_hard_wins:\n        rulesHardWins,\n    },\n  });\n}\n\n\nreturn packageRows;"},"typeVersion":2}],"active":false,"pinData":{"Run the pipeline":[{"json":{},"pairedItem":{"item":0}}],"Embed with Hugging Face":[{"json":{"body":[[-0.019890284165740013,0.026717206463217735,-0.007671079132705927,0.05450795590877533,0.09937181323766708,0.057070665061473846,0.09100086241960526,-0.022363074123859406,0.103763148188591,-0.017660746350884438,0.053105030208826065,0.0032123434357345104,-0.06442520022392273,0.009389822371304035,-0.0560481883585453,-0.07596226036548615,-0.03308989480137825,-0.06027108430862427,-0.007414138410240412,-0.04147516191005707,-0.04595597833395004,-0.07243146747350693,-0.03481382504105568,0.0025359021965414286,0.006909403018653393,-0.02535153739154339,-0.0535086989402771,-0.03522498533129692,-0.044277630746364594,0.0008135995012708008,0.12023374438285828,0.10593025386333466,0.014348483644425869,-0.047095902264118195,0.040970224887132645,0.008717665448784828,0.0573071613907814,0.014844469726085663,0.031057504937052727,-0.0277812909334898,-0.06651396304368973,-0.0514972060918808,0.023081928491592407,-0.04012123495340347,0.021624665707349777,-0.00994754210114479,0.032492585480213165,-0.03932499140501022,0.0306834876537323,0.035952065140008926,0.05350837484002113,-0.07210290431976318,0.018292009830474854,0.012205852195620537,-0.02377064898610115,0.013620949350297451,0.054649755358695984,-0.041470132768154144,-0.10035784542560577,0.028705930337309837,-0.05200079828500748,-0.03529845178127289,0.04574474319815636,-0.01976308412849903,-0.02681588940322399,0.061581987887620926,-0.036073826253414154,-0.028165724128484726,0.10456150770187378,-0.025503141805529594,0.04051346331834793,-0.001933364081196487,-0.02554210089147091,-0.009836194105446339,0.03181327506899834,0.04769524559378624,-0.014336809515953064,0.030288752168416977,0.11234299093484879,-0.051398321986198425,-0.03259989246726036,0.0384